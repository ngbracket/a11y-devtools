{
  "name": "@ngbracket/a11y-devtools",
  "version": "0.8.0",
  "description": "Dev-only in-app accessibility auditing for Angular that maps each axe violation back to the component that rendered it — the attribution React overlay tools can't do.",
  "license": "MIT",
  "author": "Duncan Faulkner",
  "contributors": [
    "Lara Sanz"
  ],
  "homepage": "https://ngbracket.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngbracket/a11y-devtools.git"
  },
  "keywords": [
    "angular",
    "accessibility",
    "a11y",
    "devtools",
    "axe-core",
    "axe",
    "ngbracket"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ngbr-a11y-report": "bin/ngbr-a11y-report.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-inpage.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:console": "vitest run --config vitest.demo.config.ts --disableConsoleIntercept",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axe-core": "^4.13.0"
  },
  "peerDependencies": {
    "@angular/core": ">=18.0.0",
    "rxjs": ">=7.0.0",
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.40.0",
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@analogjs/vitest-angular": "^2.7.2",
    "@angular/build": "^22.1.7",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@oxc-project/runtime": "^0.149.0",
    "@types/node": "^26.5.0",
    "jsdom": "^30.0.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
